// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String             @id @default(uuid())
  name          String?
  email         String             @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]
  organizations UserOrganization[]
  bookings      Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("account")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_token")
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticator")
}

model UserOrganization {
  userId    String
  orgId     String
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@id([userId, orgId]) // Composite Primary Key
  @@map("user_organization")
}

model Organization {
  id         String             @id @default(uuid())
  name       String
  createdAt  DateTime           @default(now())
  externalId String?
  locations  Location[]
  buildings  Building[]
  floors     Floor[]
  users      UserOrganization[]
  bookings   Booking[]
  spaces     Space[]

  @@index([externalId])
  @@map("organization")
}

model Location {
  id        String     @id @default(uuid())
  name      String
  address   String?
  tz        String?
  createdAt DateTime   @default(now())
  orgId     String
  buildings Building[]
  latitude  Float
  longitude Float

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("location")
}

model Building {
  id         String  @id @default(uuid())
  name       String
  address    String?
  locationId String
  orgId      String
  floors     Floor[]
  footprints Json    @default("[]")

  location Location     @relation(fields: [locationId], references: [id])
  org      Organization @relation(fields: [orgId], references: [id])

  @@index([locationId, orgId])
  @@map("building")
}

model Floor {
  id           String       @id @default(uuid())
  name         String
  orgId        String
  buildingId   String
  spaces       Space[]
  building     Building     @relation(fields: [buildingId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  // 1. Permanent physical inventory on this floor
  assets BookableAsset[]

  // 2. Versioned visual configurations
  floorPlans        FloorPlan[] @relation("FloorToFloorPlans")
  activeFloorPlanId String?     @unique
  activeFloorPlan   FloorPlan?  @relation("ActiveFloorPlan", fields: [activeFloorPlanId], references: [id], onDelete: SetNull)

  @@index([buildingId, orgId])
  @@map("floor")
}

// NEW: This holds the permanent identity and booking records
model BookableAsset {
  id      String @id @default(uuid())
  name    String // e.g., "Desk A-12"
  orgId   String
  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  // Bookings point HERE. They never break when layouts change!
  bookings Booking[]

  // Visual instances of this asset across different floor plan versions
  spaces Space[]

  @@unique([floorId, name]) // Prevents duplicate desk names on the same floor
  @@map("bookable_asset")
}

model FloorPlan {
  id       String             @id @default(uuid())
  name     String
  floorId  String
  floor    Floor              @relation("FloorToFloorPlans", fields: [floorId], references: [id], onDelete: Cascade)
  elements FloorPlanElement[]

  // Back-relation for the active configuration
  activeForFloor Floor? @relation("ActiveFloorPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spaces    Space[]

  @@map("floor_plan")
}

model FloorPlanElement {
  id          String    @id @default(uuid())
  type        String?
  attrs       Json
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  // Strict 1-to-1 relationship with Space within this layout
  spaceId String? @unique
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@map("floor_plan_element")
}

enum SpaceStatus {
  AVAILABLE   @map("available")
  OCCUPIED    @map("occupied")
  RESERVED    @map("reserved")
  MAINTENANCE @map("maintenance")
}

model Space {
  id           String       @id @default(uuid())
  name         String
  status       SpaceStatus  @default(AVAILABLE)
  bookings     Booking[]
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  floor        Floor        @relation(fields: [floorId], references: [id])
  floorId      String

  // --- Enforces that a Space belongs to exactly 1 FloorPlan ---
  floorPlanId String
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  // Back-relation to the visual canvas shape
  floorPlanElement FloorPlanElement?
  // Points to the permanent physical asset
  assetId          String
  asset            BookableAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("space")
}

model Booking {
  id        String   @id @default(uuid())
  orgId     String
  spaceId   String
  userId    String
  title     String
  startTs   DateTime
  endTs     DateTime
  allDay    Boolean  @default(false)
  url       String?
  createdAt DateTime @default(now())

  organization    Organization   @relation(fields: [orgId], references: [id])
  space           Space          @relation(fields: [spaceId], references: [id])
  user            User           @relation(fields: [userId], references: [id])
  bookableAsset   BookableAsset? @relation(fields: [bookableAssetId], references: [id])
  bookableAssetId String?

  @@index([orgId])
  @@index([spaceId, startTs, endTs])
  @@index([orgId, userId, startTs, endTs])
  @@map("booking")
}
